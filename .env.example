# Copiá este archivo como .env.local (local) o cargá las variables en
# Vercel → Settings → Environment Variables. Nunca subas los valores reales.

# URL pública del sitio (canonical, links en WhatsApp, Open Graph)
NEXT_PUBLIC_SITE_URL=https://fzcases.com

# Supabase (opcionales: si no están, se usan las públicas del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role: necesaria para guardar los pedidos del checkout.
# Supabase → Project Settings → API → service_role. SECRETA.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago: Access Token de la aplicación (empieza con APP_USR). SECRETO.
MP_ACCESS_TOKEN=
